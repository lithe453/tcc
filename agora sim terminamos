        )

    sala.trace_add("write", atualizar_filme)
    periodo.trace_add("write", atualizar_filme)

    atualizar_filme()

    ctk.CTkLabel(
        conteudo,
        text="Quantidade de ingressos:"
    ).pack()

    quantidade_ingressos = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=quantidade_ingressos,
        values=[str(i) for i in range(1, 11)]
    ).pack(pady=8)

    ctk.CTkLabel(
        conteudo,
        text="Pipoca:"
    ).pack(pady=(15, 5))

    pipoca = ctk.StringVar(value="Nenhuma")

    ctk.CTkOptionMenu(
        conteudo,
        variable=pipoca,
        values=[
            "Nenhuma",
            "Pipoca pequena",
            "Pipoca média",
            "Pipoca grande"
        ]
    ).pack(pady=8)

    ctk.CTkLabel(
        conteudo,
        text="Quantidade de pipocas:"
    ).pack()

    quantidade_pipoca = ctk.StringVar(value="0")

    ctk.CTkOptionMenu(
        conteudo,
        variable=quantidade_pipoca,
        values=[str(i) for i in range(0, 11)]
    ).pack(pady=8)

    ctk.CTkLabel(
        conteudo,
        text="Refrigerante:"
    ).pack(pady=(15, 5))

    refrigerante = ctk.StringVar(value="Nenhum")

    ctk.CTkOptionMenu(
        conteudo,
        variable=refrigerante,
        values=[
            "Nenhum",
            "Coca-Cola",
            "Guaraná",
            "Fanta",
            "Sprite"
        ]
    ).pack(pady=8)

    ctk.CTkLabel(
        conteudo,
        text="Quantidade de refrigerantes:"
    ).pack()

    quantidade_refrigerante = ctk.StringVar(value="0")

    ctk.CTkOptionMenu(
        conteudo,
        variable=quantidade_refrigerante,
        values=[str(i) for i in range(0, 11)]
    ).pack(pady=8)

    total = ctk.CTkLabel(
        conteudo,
        text="Total: R$ 20,00",
        font=("Arial", 20, "bold"),
        text_color="#9CC9F5"
    )
    total.pack(pady=20)

    def calcular_total(*args):
        if periodo.get() == "Tarde":
            preco_ingresso = 20.00
        else:
            preco_ingresso = 25.00

        quantidade_ingressos_valor = int(quantidade_ingressos.get())

        precos_pipoca = {
            "Nenhuma": 0.00,
            "Pipoca pequena": 10.00,
            "Pipoca média": 15.00,
            "Pipoca grande": 20.00
        }

        precos_refrigerante = {
            "Nenhum": 0.00,
            "Coca-Cola": 8.00,
            "Guaraná": 7.00,
            "Fanta": 7.00,
            "Sprite": 7.00
        }

        quantidade_pipoca_valor = int(quantidade_pipoca.get())
        quantidade_refrigerante_valor = int(quantidade_refrigerante.get())

        preco_pipoca = precos_pipoca[pipoca.get()]
        preco_refrigerante = precos_refrigerante[refrigerante.get()]

        valor_total = (
            preco_ingresso * quantidade_ingressos_valor
            + preco_pipoca * quantidade_pipoca_valor
            + preco_refrigerante * quantidade_refrigerante_valor
        )

        total.configure(
            text=f"Total: R$ {valor_total:.2f}".replace(".", ",")
        )

    periodo.trace_add("write", calcular_total)
    quantidade_ingressos.trace_add("write", calcular_total)
    pipoca.trace_add("write", calcular_total)
    quantidade_pipoca.trace_add("write", calcular_total)
    refrigerante.trace_add("write", calcular_total)
    quantidade_refrigerante.trace_add("write", calcular_total)

    def finalizar_compra():

        if pipoca.get() == "Nenhuma":
            quantidade_pipoca.set("0")

        if refrigerante.get() == "Nenhum":
            quantidade_refrigerante.set("0")

        calcular_total()

        if periodo.get() == "Tarde":
            preco_ingresso = 20.00
        else:
            preco_ingresso = 25.00

        precos_pipoca = {
            "Nenhuma": 0.00,
            "Pipoca pequena": 10.00,
            "Pipoca média": 15.00,
            "Pipoca grande": 20.00
        }

        precos_refrigerante = {
            "Nenhum": 0.00,
            "Coca-Cola": 8.00,
            "Guaraná": 7.00,
            "Fanta": 7.00,
            "Sprite": 7.00
        }

        qtd_ingressos = int(quantidade_ingressos.get())
        qtd_pipocas = int(quantidade_pipoca.get())
        qtd_refrigerantes = int(quantidade_refrigerante.get())

        valor_total = (
            preco_ingresso * qtd_ingressos
            + precos_pipoca[pipoca.get()] * qtd_pipocas
            + precos_refrigerante[refrigerante.get()] * qtd_refrigerantes
        )

        historico_compras_lista.append({
            "data": datetime.now(),
            "sala": int(sala.get()),
            "periodo": periodo.get(),
            "filme": FILMES[int(sala.get())][periodo.get()],
            "ingressos": qtd_ingressos,
            "pipoca": pipoca.get(),
            "qtd_pipocas": qtd_pipocas,
            "refrigerante": refrigerante.get(),
            "qtd_refrigerantes": qtd_refrigerantes,
            "total": valor_total
        })

        messagebox.showinfo(
            "Compra realizada",
            f"Compra realizada com sucesso!\n\n"
            f"Filme: {FILMES[int(sala.get())][periodo.get()]}\n"
            f"Sala: {sala.get()}\n"
            f"Período: {periodo.get()}\n"
            f"Ingressos: {qtd_ingressos}\n"
            f"Pipoca: {pipoca.get()}\n"
            f"Quantidade de pipocas: {qtd_pipocas}\n"
            f"Refrigerante: {refrigerante.get()}\n"
            f"Quantidade de refrigerantes: {qtd_refrigerantes}\n\n"
            f"Total: R$ {valor_total:.2f}".replace(".", ",")
        )

        comprar_tela()

    ctk.CTkButton(
        conteudo,
        text="💳 Finalizar compra",
        width=250,
        height=45,
        command=finalizar_compra
    ).pack(pady=10)


