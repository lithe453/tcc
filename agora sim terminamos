    ).pack(pady=8)

    ctk.CTkLabel(
        conteudo,
        text="Período:"
    ).pack()

    periodo = ctk.StringVar(value="Tarde")

    ctk.CTkOptionMenu(
        conteudo,
        variable=periodo,
        values=["Tarde", "Noite"]
    ).pack(pady=8)

    filme = ctk.CTkLabel(
        conteudo,
        text=FILMES[1]["Tarde"],
