    ctk.CTkOptionMenu(
        conteudo,
        variable=quantidade,
        values=[str(i) for i in range(1, 11)],
        width=150
    ).pack(pady=8)

    valor_cancelado_label = ctk.CTkLabel(
        conteudo,
        text="Valor a cancelar: R$ 0,00",
        font=("Arial", 17, "bold"),
        text_color="#FFB347"
    )
    valor_cancelado_label.pack(pady=15)

    def atualizar_detalhes(*args):
        try:
            indice = opcoes_compras.index(compra_selecionada.get())
            registro = historico_compras_lista[indice]

            detalhes.configure(
                text=(
                    f"🎬 {registro['filme']}\n"
                    f"Sala {registro['sala']} - {registro['periodo']}\n"
                    f"Ingressos: {registro['ingressos']} | "
                    f"Pipocas: {registro['qtd_pipocas']} | "
                    f"Refrigerantes: {registro['qtd_refrigerantes']}\n"
                    f"Total atual: R$ {registro['total']:.2f}"
                ).replace(".", ",")
            )

            if item.get() == "Compra inteira":
                quantidade.configure(value="1")

            elif item.get() == "Ingressos":
                quantidade.configure(
                    value="1",
                    values=[
                        str(i)
                        for i in range(1, registro["ingressos"] + 1)
                    ]
                )

            elif item.get() == "Pipoca":
                if registro["qtd_pipocas"] > 0:
                    quantidade.configure(
                        value="1",
                        values=[
                            str(i)
                            for i in range(1, registro["qtd_pipocas"] + 1)
                        ]
                    )
                else:
                    quantidade.configure(
                        value="1",
                        values=["1"]
                    )

            elif item.get() == "Refrigerante":
                if registro["qtd_refrigerantes"] > 0:
                    quantidade.configure(
                        value="1",
                        values=[
                            str(i)
                            for i in range(
                                1,
                                registro["qtd_refrigerantes"] + 1
                            )
                        ]
                    )
                else:
                    quantidade.configure(
                        value="1",
                        values=["1"]
                    )

            atualizar_valor()

        except:
            pass

    def atualizar_valor(*args):
        try:
            indice = opcoes_compras.index(compra_selecionada.get())
            registro = historico_compras_lista[indice]

            qtd = int(quantidade.get())

            if item.get() == "Ingressos":
                preco = 20.00 if registro["periodo"] == "Tarde" else 25.00
                valor = preco * qtd

            elif item.get() == "Pipoca":
                precos = {
                    "Nenhuma": 0.00,
                    "Pipoca pequena": 10.00,
                    "Pipoca média": 15.00,
                    "Pipoca grande": 20.00
                }
                valor = precos[registro["pipoca"]] * qtd

            elif item.get() == "Refrigerante":
                precos = {
                    "Nenhum": 0.00,
                    "Coca-Cola": 8.00,
                    "Guaraná": 7.00,
                    "Fanta": 7.00,
                    "Sprite": 7.00
                }
                valor = precos[registro["refrigerante"]] * qtd

            else:
                valor = registro["total"]

            valor_cancelado_label.configure(
                text=f"Valor a cancelar: R$ {valor:.2f}".replace(".", ",")
            )

        except:
            valor_cancelado_label.configure(
                text="Valor a cancelar: R$ 0,00"
            )

    def cancelar_item():

        if not historico_compras_lista:
            return

        try:
            indice = opcoes_compras.index(compra_selecionada.get())
            registro = historico_compras_lista[indice]
            qtd = int(quantidade.get())

            if item.get() == "Ingressos":

                if qtd > registro["ingressos"]:
                    messagebox.showerror(
                        "Erro",
                        "Quantidade de ingressos inválida."
                    )
                    return

                preco = 20.00 if registro["periodo"] == "Tarde" else 25.00
                valor_cancelado = preco * qtd

                registro["ingressos"] -= qtd
                registro["total"] -= valor_cancelado

                if registro["ingressos"] == 0:
                    messagebox.showinfo(
                        "Cancelado",
                        "Todos os ingressos dessa compra foram cancelados."
                    )

            elif item.get() == "Pipoca":

                if registro["qtd_pipocas"] <= 0:
                    messagebox.showerror(
                        "Erro",
                        "Essa compra não possui pipocas."
                    )
                    return

                if qtd > registro["qtd_pipocas"]:
                    messagebox.showerror(
                        "Erro",
                        "Quantidade de pipocas inválida."
                    )
                    return

                precos = {
                    "Nenhuma": 0.00,
                    "Pipoca pequena": 10.00,
                    "Pipoca média": 15.00,
                    "Pipoca grande": 20.00
                }

                valor_cancelado = precos[registro["pipoca"]] * qtd

                registro["qtd_pipocas"] -= qtd
                registro["total"] -= valor_cancelado

                if registro["qtd_pipocas"] == 0:
                    registro["pipoca"] = "Nenhuma"

            elif item.get() == "Refrigerante":

                if registro["qtd_refrigerantes"] <= 0:
                    messagebox.showerror(
                        "Erro",
                        "Essa compra não possui refrigerantes."
                    )
                    return

                if qtd > registro["qtd_refrigerantes"]:
                    messagebox.showerror(
                        "Erro",
                        "Quantidade de refrigerantes inválida."
                    )
                    return

                precos = {
                    "Nenhum": 0.00,
                    "Coca-Cola": 8.00,
                    "Guaraná": 7.00,
                    "Fanta": 7.00,
                    "Sprite": 7.00
                }

                valor_cancelado = precos[registro["refrigerante"]] * qtd

                registro["qtd_refrigerantes"] -= qtd
                registro["total"] -= valor_cancelado

                if registro["qtd_refrigerantes"] == 0:
                    registro["refrigerante"] = "Nenhum"

            else:

                registro["ingressos"] = 0
                registro["qtd_pipocas"] = 0
                registro["qtd_refrigerantes"] = 0
                registro["pipoca"] = "Nenhuma"
                registro["refrigerante"] = "Nenhum"
                registro["total"] = 0.00

            if registro["total"] < 0:
                registro["total"] = 0.00

            historico_cancelamentos_lista.append({
                "data": datetime.now(),
                "tipo": "Item da compra",
                "filme": registro["filme"],
                "sala": registro["sala"],
                "periodo": registro["periodo"],
                "item": item.get(),
                "quantidade": qtd
            })

            messagebox.showinfo(
                "Cancelamento realizado",
                f"{item.get()} cancelado com sucesso!"
            )

            cancelar_itens_compra()

        except Exception as erro:
            messagebox.showerror(
                "Erro",
                str(erro)
            )

    compra_selecionada.trace_add(
        "write",
        atualizar_detalhes
    )

    item.trace_add(
        "write",
        atualizar_detalhes
    )

    quantidade.trace_add(
        "write",
        atualizar_valor
    )

    atualizar_detalhes()

    ctk.CTkButton(
        conteudo,
        text="↩️ Cancelar item",
        width=250,
        height=45,
        fg_color="#8B0000",
        hover_color="#B22222",
        command=cancelar_item
    ).pack(pady=20)


