    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Sala:").pack()

    sala = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=sala,
        values=["1", "2", "3"]
    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Fila:").pack()

    fila = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=fila,
        values=[str(i) for i in range(1, NUM_FILAS + 1)]
    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Lugar:").pack()

    lugar = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=lugar,
        values=[str(i) for i in range(1, LUGARES + 1)]
    ).pack(pady=8)

    def cancelar():

        banco = None
        cursor = None

        try:
            banco = conectar()
            cursor = banco.cursor()

            cursor.execute("""
                SELECT id_assento
                FROM assento
                WHERE id_sala = %s
                AND fila = %s
                AND lugar = %s
            """, (
                int(sala.get()),
                int(fila.get()) - 1,
                int(lugar.get()) - 1
            ))

            resultado = cursor.fetchone()

            if not resultado:
                messagebox.showerror(
                    "Erro",
                    "Assento não encontrado!"
                )
                return

            id_assento = resultado[0]

            cursor.execute("""
                SELECT id_reserva
                FROM reserva
                WHERE id_assento = %s
                AND turno = %s
            """, (
                id_assento,
                periodo.get().lower()
            ))

            if not cursor.fetchone():
                messagebox.showerror(
                    "Erro",
                    "Esse lugar não está reservado para esse período!"
                )
                return

            cursor.execute("""
                DELETE FROM reserva
                WHERE id_assento = %s
                AND turno = %s
            """, (
                id_assento,
                periodo.get().lower()
            ))

            historico_cancelamentos_lista.append({
                "data": datetime.now(),
                "sala": int(sala.get()),
                "fila": int(fila.get()),
                "lugar": int(lugar.get()),
                "periodo": periodo.get(),
                "filme": FILMES[int(sala.get())][periodo.get()]
            })

            banco.commit()

            messagebox.showinfo(
                "Sucesso",
                f"Reserva do lugar {lugar.get()}, "
                f"fila {fila.get()}, sala {sala.get()} "
                f"no período da {periodo.get().lower()} cancelada!"
            )

            cancelar_tela()

        except Exception as erro:

            if banco:
                banco.rollback()

            messagebox.showerror(
                "Erro",
                f"Erro ao cancelar:\n{erro}"
            )

        finally:

            if cursor:
                cursor.close()

            if banco:
                banco.close()

    ctk.CTkButton(
        conteudo,
        text="Cancelar reserva",
        width=250,
        height=45,
        fg_color="#8B0000",
        hover_color="#B22222",
        command=cancelar
    ).pack(pady=25)


