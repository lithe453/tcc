        conteudo,
        text="Escolha uma opção no menu ao lado.",
        font=("Arial", 16),
        text_color="#B8CCE0"
    ).pack(pady=20)


def mostrar_salas():
    limpar()
    titulo("Escolha uma sala")

    for sala in range(1, NUM_SALAS + 1):

        frame = ctk.CTkFrame(
            conteudo,
            fg_color="#1E3A5F",
            corner_radius=12
        )
        frame.pack(pady=10)

        ctk.CTkLabel(
            frame,
            text=f"SALA {sala}",
            font=("Arial", 18, "bold")
        ).pack(pady=10)

        for periodo, emoji in [("Tarde", "🌞"), ("Noite", "🌙")]:
            ctk.CTkButton(
                frame,
                text=f"{emoji} {periodo} - {FILMES[sala][periodo]}",
                width=500,
                height=45,
                command=lambda s=sala, p=periodo: mostrar_sala(s, p)
            ).pack(pady=6, padx=20)

        ctk.CTkLabel(frame, text="").pack(pady=3)


def mostrar_sala(sala, periodo):
    limpar()

    titulo(f"SALA {sala} - {periodo.upper()}")

    ctk.CTkLabel(
        conteudo,
        text=FILMES[sala][periodo],
        font=("Arial", 18),
        text_color="#D6E6F5"
    ).pack()

    try:
        imagem = Image.open(CARTAZES[sala][periodo])
        imagem.thumbnail((110, 150))
        poster = ImageTk.PhotoImage(imagem)

        label = ctk.CTkLabel(conteudo, image=poster, text="")
        label.image = poster
        label.pack(pady=5)
    except:
        pass

    try:
        banco = conectar()
        cursor = banco.cursor()

        cursor.execute("""
            SELECT a.fila, a.lugar,
                   CASE
                       WHEN r.id_reserva IS NULL THEN 0
                       ELSE 1
                   END
            FROM assento a
            LEFT JOIN reserva r
            ON a.id_assento = r.id_assento
            WHERE a.id_sala = %s
            ORDER BY a.fila, a.lugar
        """, (sala,))

        assentos = cursor.fetchall()

        cursor.close()
        banco.close()

    except Exception as erro:
        messagebox.showerror("Erro", str(erro))
        return

    grade = ctk.CTkFrame(
        conteudo,
        fg_color="#1E3A5F",
        corner_radius=12
    )
    grade.pack(pady=10)

    ctk.CTkLabel(
        grade,
        text="TELA",
        fg_color="#0F2035",
        text_color="white",
        font=("Arial", 14, "bold"),
        height=35,
        corner_radius=8
    ).grid(
        row=0,
        column=0,
        columnspan=LUGARES + 1,
        sticky="ew",
        padx=15,
        pady=15
    )

    # Números dos lugares
    for lugar in range(1, LUGARES + 1):
        ctk.CTkLabel(
            grade,
            text=str(lugar),
            width=30,
            font=("Arial", 9, "bold")
        ).grid(row=1, column=lugar, padx=2)

    # Nomes das filas
    for fila in range(1, NUM_FILAS + 1):
        ctk.CTkLabel(
            grade,
            text=f"Fila {fila}",
            width=65,
            font=("Arial", 9, "bold")
        ).grid(row=fila + 1, column=0, padx=3, pady=3)

    # Assentos
    for fila, lugar, reservado in assentos:

        if 0 <= fila < NUM_FILAS and 0 <= lugar < LUGARES:

            cor = "#B22222" if reservado else "#2E8B57"
            texto = "X" if reservado else str(lugar + 1)

            ctk.CTkLabel(
                grade,
                text=texto,
                width=30,
                height=30,
                fg_color=cor,
                text_color="white",
                corner_radius=5
            ).grid(
                row=fila + 2,
                column=lugar + 1,
                padx=2,
                pady=3
            )

    ctk.CTkLabel(
        conteudo,
        text="🟩 Livre       🟥 X = Reservado",
        font=("Arial", 12, "bold")
    ).pack(pady=10)


def reservar_tela():
    limpar()
    titulo("Reservar Lugar")

    ctk.CTkLabel(conteudo, text="Data:").pack()

    calendario = DateEntry(
        conteudo,
        width=20,
        date_pattern="dd/mm/yyyy"
    )
    calendario.pack(pady=8)

    ctk.CTkLabel(conteudo, text="Período:").pack()

    periodo = ctk.StringVar(value="Tarde")

    ctk.CTkOptionMenu(
        conteudo,
        variable=periodo,
        values=["Tarde", "Noite"]
    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Sala:").pack()

    sala = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=sala,
        values=["1", "2", "3"]
    ).pack(pady=8)

    filme = ctk.CTkLabel(
        conteudo,
        text=FILMES[1]["Tarde"],
        font=("Arial", 14, "bold"),
        text_color="#9CC9F5"
    )
    filme.pack(pady=5)

    def atualizar_filme(*args):
        filme.configure(
            text=FILMES[int(sala.get())][periodo.get()]
        )

    sala.trace_add("write", atualizar_filme)
    periodo.trace_add("write", atualizar_filme)

    ctk.CTkLabel(conteudo, text="Fila:").pack()

    fila = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=fila,
        values=[str(i) for i in range(1, NUM_FILAS + 1)]
    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Lugar:").pack()

    lugar = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=lugar,
        values=[str(i) for i in range(1, LUGARES + 1)]
    ).pack(pady=8)

    def reservar():

        banco = None
        cursor = None

        try:
            banco = conectar()
            cursor = banco.cursor()

            cursor.execute("""
                SELECT id_assento
                FROM assento
                WHERE id_sala = %s
                AND fila = %s
                AND lugar = %s
            """, (
                int(sala.get()),
                int(fila.get()) - 1,
                int(lugar.get()) - 1
            ))

            resultado = cursor.fetchone()

            if not resultado:
                messagebox.showerror(
                    "Erro",
                    "Assento não encontrado!"
                )
                return

            id_assento = resultado[0]

            cursor.execute("""
                SELECT id_reserva
                FROM reserva
                WHERE id_assento = %s
            """, (id_assento,))

            if cursor.fetchone():
                messagebox.showerror(
                    "Erro",
                    "Esse lugar já está reservado!"
                )
                return

            cursor.execute("""
                INSERT INTO reserva (id_assento)
                VALUES (%s)
            """, (id_assento,))

            banco.commit()

            messagebox.showinfo(
                "Sucesso",
                f"Lugar {lugar.get()}, fila {fila.get()}, "
                f"sala {sala.get()} reservado com sucesso!"
            )

            reservar_tela()

        except Exception as erro:

            if banco:
                banco.rollback()

            messagebox.showerror(
                "Erro",
                f"Erro ao reservar:\n{erro}"
            )

        finally:

            if cursor:
                cursor.close()

            if banco:
                banco.close()

    ctk.CTkButton(
        conteudo,
        text="Reservar",
        width=250,
        height=45,
        command=reservar
    ).pack(pady=20)


def cancelar_tela():
    limpar()
    titulo("Cancelar Reserva")

    ctk.CTkLabel(conteudo, text="Sala:").pack()

    sala = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=sala,
        values=["1", "2", "3"]
    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Fila:").pack()

    fila = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=fila,
        values=[str(i) for i in range(1, NUM_FILAS + 1)]
    ).pack(pady=8)

    ctk.CTkLabel(conteudo, text="Lugar:").pack()

    lugar = ctk.StringVar(value="1")

    ctk.CTkOptionMenu(
        conteudo,
        variable=lugar,
        values=[str(i) for i in range(1, LUGARES + 1)]
    ).pack(pady=8)

    def cancelar():

        banco = None
        cursor = None

        try:
            banco = conectar()
            cursor = banco.cursor()

            cursor.execute("""
                SELECT id_assento
                FROM assento
                WHERE id_sala = %s
                AND fila = %s
                AND lugar = %s
            """, (
                int(sala.get()),
                int(fila.get()) - 1,
                int(lugar.get()) - 1
            ))

            resultado = cursor.fetchone()

            if not resultado:
                messagebox.showerror(
                    "Erro",
                    "Assento não encontrado!"
                )
                return

            id_assento = resultado[0]

            cursor.execute("""
                SELECT id_reserva
                FROM reserva
                WHERE id_assento = %s
            """, (id_assento,))

            if not cursor.fetchone():
                messagebox.showerror(
                    "Erro",
                    "Esse lugar não está reservado!"
                )
                return

            cursor.execute("""
                DELETE FROM reserva
                WHERE id_assento = %s
            """, (id_assento,))

            banco.commit()

            messagebox.showinfo(
                "Sucesso",
                f"Reserva do lugar {lugar.get()}, "
                f"fila {fila.get()}, sala {sala.get()} cancelada!"
            )

            cancelar_tela()

        except Exception as erro:

            if banco:
                banco.rollback()

            messagebox.showerror(
                "Erro",
                f"Erro ao cancelar:\n{erro}"
            )

        finally:

            if cursor:
                cursor.close()

            if banco:
                banco.close()

    ctk.CTkButton(
        conteudo,
        text="Cancelar reserva",
        width=250,
        height=45,
        fg_color="#8B0000",
        hover_color="#B22222",
        command=cancelar
    ).pack(pady=25)


