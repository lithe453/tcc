    1: {"Tarde": "Homem-Aranha.png", "Noite": "Avengers_Doomsday.png"},
    2: {"Tarde": "odisseia.png", "Noite": "Obsession.png"},
    3: {"Tarde": "toy-story.png", "Noite": "RE.png"}
}


