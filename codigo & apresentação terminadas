NUM_FILAS = 10
LUGARES = 20

FILMES = {
    1: {"Tarde": "Homem-Aranha: Brand New Day", "Noite": "Vingadores: Doomsday"},
    2: {"Tarde": "A Odisseia", "Noite": "Obsessão"},
    3: {"Tarde": "Toy Story 5", "Noite": "Resident Evil"}
}

CARTAZES = {
    1: {"Tarde": "Homem-Aranha.png", "Noite": "Avengers_Doomsday.png"},
    2: {"Tarde": "odisseia.png", "Noite": "Obsession.png"},
    3: {"Tarde": "toy-story.png", "Noite": "RE.png"}
}


def conectar():
    return psycopg2.connect(
        host="localhost",
        user="postgres",
        password="root",
        port="5432",
        dbname="cinema"
    )


ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")

root = ctk.CTk()
root.title("Gerenciador de Cinema")
root.geometry("1400x850")
