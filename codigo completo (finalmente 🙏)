    def cancelar():

        sala = int(
            sala_var.get()
        )

        fila = int(
            fila_var.get()
        ) - 1

        lugar = int(
            lugar_var.get()
        ) - 1

        conexao = None
        cursor = None

        try:
            conexao = conectar_banco()
            cursor = conexao.cursor()

