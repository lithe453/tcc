def fechar_janela_anterior():

    global janela_atual

    if janela_atual is not None:

        try:

            if janela_atual.winfo_exists():

                janela_atual.destroy()

        except:

            pass

        janela_atual = None


# ============================================================
# TESTE DE CONEXÃO
# ============================================================

try:

